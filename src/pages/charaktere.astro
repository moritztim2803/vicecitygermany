---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { CHARAKTERE, GRUPPEN } from '../data/charaktere';
import { SITE } from '../site.config';

const initialen = (n: string) => n.replace(/^Officer /, '').split(/[\s-]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const gruppen = GRUPPEN.map((g) => ({ ...g, items: CHARAKTERE.filter((c) => c.gruppe === g.id) })).filter((g) => g.items.length);
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Alle Charaktere in GTA 6', numberOfItems: CHARAKTERE.length,
  itemListElement: CHARAKTERE.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: `${SITE.url}/charaktere/#${c.id}` })),
}];
---
<Base title="GTA 6 Charaktere: Alle Figuren im Überblick (ohne Spoiler)" description={`Alle ${CHARAKTERE.length} wichtigen Charaktere aus GTA 6: Jason, Lucia, Cal, Brian, Boobie, Real Dimez und mehr. Wer sie sind und wo du sie triffst, spoilerfrei.`} jsonLd={jsonLd}>
  <header class="ch-head">
    <p class="eyebrow">Wer ist wer in Leonida</p>
    <h1>Alle Charaktere in GTA 6</h1>
    <p class="lead">{CHARAKTERE.length} Figuren, die du im Spiel triffst: wer sie sind, wo sie wohnen und was du mit ihnen zu tun hast. Garantiert ohne Story-Spoiler.</p>
    <nav class="ch-filter" aria-label="Nach Gruppe filtern">
      <button type="button" data-f="alle" aria-pressed="true">Alle <span>{CHARAKTERE.length}</span></button>
      {gruppen.map((g) => <button type="button" data-f={g.id} aria-pressed="false">{g.name} <span>{g.items.length}</span></button>)}
    </nav>
  </header>


  {gruppen.map((g, gi) => (
    <section class="ch-group" data-g={g.id} aria-labelledby={`g-${g.id}`}>
      <h2 class="section-title" id={`g-${g.id}`}>{g.name}</h2>
      <p class="ch-gtext">{g.text}</p>
      <div class="ch-grid">
        {g.items.map((c, i) => (
          <article class="ch-card" id={c.id} style={`--c:${c.c};--i:${i}`}>
            <span class="ch-av">{initialen(c.name)}</span>
            <div class="ch-body">
              <h3>{c.name}</h3>
              <p class="ch-kurz">{c.kurz}</p>
              <ul class="ch-tags">
                {c.spielbar && <li class="t-play">Spielbar</li>}
                {c.offiziell && <li>Von Rockstar vorgestellt</li>}
                {c.ort && <li>{c.ort}</li>}
              </ul>
              <p>{c.rolle}</p>
              {c.links?.map((l) => <a class="ch-link" href={l.href}>{l.text} →</a>)}
            </div>
          </article>
        ))}
      </div>
      {gi === 1 && <AdSlot name="in-article" />}
    </section>
  ))}

  <aside class="ch-note">
    <h2>Warum fehlen manche Figuren?</h2>
    <p>Wir nehmen nur Figuren auf, die wir ohne Story-Spoiler vorstellen können. Wer erst später in der Geschichte wichtig wird, kommt hier nicht vor. Fehlt dir jemand? <a href="/easter-egg-melden/">Schreib uns</a>.</p>
  </aside>
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.ch-filter button');
  const groups = document.querySelectorAll<HTMLElement>('.ch-group');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    groups.forEach((g) => { g.hidden = f !== 'alle' && g.dataset.g !== f; });
  }));
</script>

<style>
  .ch-head { padding: 8px 0 4px; }
  .ch-head h1 { text-shadow: 0 0 22px rgb(255 79 163 / .5); }
  .ch-filter { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .ch-filter button { font: 600 .9rem var(--font-body); color: var(--muted); background: var(--night-2); border: 1px solid var(--night-3);
    border-radius: 99px; padding: 7px 14px; cursor: pointer; }
  .ch-filter button span { color: var(--cyan); margin-left: 4px; font-variant-numeric: tabular-nums; }
  .ch-filter button[aria-pressed='true'] { color: #fff; border-color: var(--pink); box-shadow: 0 0 16px -4px rgb(255 79 163 / .8); }


  .ch-av { flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; font: 1.35rem var(--font-display); color: #fff;
    background: radial-gradient(circle at 50% 30%, color-mix(in srgb, var(--c) 55%, #140a24), #140a24 72%);
    border: 2px solid var(--c); box-shadow: 0 0 18px -2px var(--c), inset 0 0 14px -4px var(--c); text-shadow: 0 0 10px var(--c); }
  .ch-av-xl { width: 96px; height: 96px; font-size: 2.1rem; }

  .ch-group { scroll-margin-top: 80px; }
  .ch-gtext { color: var(--muted); margin: -.6em 0 14px; }
  .ch-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; }
  .ch-card { scroll-margin-top: 90px; display: flex; gap: 16px; align-items: flex-start; padding: 18px; border-radius: 18px; border: 1px solid var(--night-3);
    background: linear-gradient(160deg, color-mix(in srgb, var(--c) 9%, transparent), var(--night-2) 55%);
    animation: tt-in .45s both; animation-delay: calc(var(--i) * 60ms); transition: border-color .2s, box-shadow .2s; }
  .ch-card:hover, .ch-card:target { border-color: var(--c); box-shadow: 0 0 30px -10px var(--c); }
  .ch-body { min-width: 0; }
  .ch-body h3 { margin: 2px 0 0; font-size: 1.25rem; color: #fff; }
  .ch-kurz { margin: 0 0 8px; color: var(--c); font-weight: 700; font-size: .92rem; }
  .ch-tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0 0 10px; }
  .ch-tags li { font: 700 .68rem var(--font-body); letter-spacing: .1em; text-transform: uppercase; color: var(--muted);
    border: 1px solid var(--night-3); border-radius: 99px; padding: 2px 9px; }
  .ch-tags .t-play { color: var(--c); border-color: var(--c); }
  .ch-body p { margin: 0 0 8px; color: var(--text); font-size: .95rem; line-height: 1.55; }
  .ch-link { display: block; font-weight: 700; font-size: .9rem; margin-top: 4px; }

  .ch-note { margin-top: 40px; padding: 18px 20px; border-radius: 16px; border: 1px dashed var(--night-3); background: rgb(30 16 53 / .5); }
  .ch-note h2 { margin: 0 0 6px; font-size: 1.15rem; }
  .ch-note p { margin: 0; color: var(--muted); }

  @media (max-width: 520px) {
    }
  @keyframes tt-in { from { opacity: .001; transform: translateY(8px); } }
</style>
