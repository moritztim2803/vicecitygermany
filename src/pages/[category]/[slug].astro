---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import SubmitCta from '../../components/SubmitCta.astro';
import LeonidaMap from '../../components/LeonidaMap.astro';
import CardTracker from '../../components/CardTracker.astro';
import RegionQuiz from '../../components/RegionQuiz.astro';
import HeatCheck from '../../components/HeatCheck.astro';
import CheatList from '../../components/CheatList.astro';
import EggStrip from '../../components/EggStrip.astro';
import ToolTiles from '../../components/ToolTiles.astro';
import { SITE, categoryBySlug } from '../../site.config';
import { allArtikel, artikelUrl, type Artikel } from '../../lib/artikel';

export async function getStaticPaths() {
  const all = await allArtikel();
  return all.map((a) => ({ params: { category: a.data.category, slug: a.id }, props: { a, all } }));
}
const { a, all } = Astro.props as { a: Artikel; all: Artikel[] };
const { Content, headings } = await render(a);
const cat = categoryBySlug(a.data.category)!;
const updated = a.data.updatedDate ?? a.data.publishDate;
const url = new URL(artikelUrl(a), Astro.site).href;
const others = all.filter((x) => x.id !== a.id);
const related = [...others.filter((x) => x.data.category === a.data.category), ...others.filter((x) => x.data.category !== a.data.category)].slice(0, 5);
const toc = headings.filter((h) => h.depth === 2);

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: a.data.title, description: a.data.description,
    datePublished: a.data.publishDate.toISOString(), dateModified: updated.toISOString(), inLanguage: 'de-DE',
    mainEntityOfPage: url, author: { '@type': 'Organization', name: SITE.name }, publisher: { '@type': 'Organization', name: SITE.name },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/kategorie/${cat.slug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: a.data.title, item: url },
    ],
  },
];
if (a.data.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: a.data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={a.data.title} description={a.data.description} type="article" jsonLd={jsonLd} ogImage={a.id === 'gta-6-quiz-welche-region' ? '/og/test.png' : undefined}>
  <nav class="breadcrumb" aria-label="Brotkrumen"><a href="/">Start</a> › <a href={`/kategorie/${cat.slug}/`}>{cat.name}</a></nav>
  <div class="article-layout">
    <article class="prose">
      <h1>{a.data.title}</h1>
      <p class="meta">Aktualisiert am <time datetime={updated.toISOString()}>{updated.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}</time></p>
      {a.id === 'gta-6-karte-regionen' && <LeonidaMap />}
      {a.id === 'gta-6-sammelkarten-tracker' && <CardTracker />}
      {a.id === 'gta-6-quiz-welche-region' && <RegionQuiz />}
      {a.id === 'gta-6-polizei-abhaengen-fahndung' && <HeatCheck />}
      {a.id === 'gta-6-cheats' && <CheatList />}
      {a.id === 'gta-6-easter-eggs' && <EggStrip here />}
      {toc.length > 2 && (
        <details class="toc" open><summary>Inhalt</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      <AdSlot name="in-article" />
      <Content />
      {a.data.category === 'easter-eggs' && <NewsletterBox />}
      {a.data.category === 'easter-eggs' && <SubmitCta />}
      {a.data.faq.length > 0 && (
        <section class="faq">
          <h2>Häufige Fragen</h2>
          {a.data.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </section>
      )}
      <AdSlot name="footer" />
    </article>
    <aside class="sidebar">
      <AdSlot name="sidebar" />
      <div class="side-tools"><h2 class="h-small">Tools</h2><ToolTiles only={['quiz', 'album', 'karte']} compact /></div>
      {related.length > 0 && <div><h2 class="h-small">Weiterlesen</h2>
        <ul class="side-rel">{related.map((r) => <li><span>{categoryBySlug(r.data.category)?.name}</span><a href={artikelUrl(r)}>{r.data.title}</a></li>)}</ul></div>}
    </aside>
  </div>
</Base>

<style>
  .side-tools { margin-bottom: 22px; }
  .side-tools :global(.tt) { grid-template-columns: 1fr; }
  .side-rel { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .side-rel li { padding: 10px 0 10px 12px; border-left: 2px solid rgb(255 79 163 / .5); }
  .side-rel span { display: block; font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; color: var(--cyan); }
  .side-rel a { color: var(--text); text-decoration: none; font-weight: 600; font-size: .95rem; line-height: 1.35; }
  .side-rel a:hover { color: var(--pink); }
</style>
