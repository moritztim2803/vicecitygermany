---
// Zubehör-Seite: alles rund um GTA 6 zum Kaufen, mit Amazon-Suchlinks.
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { SHOP } from '../data/amazon';
import { AFFILIATE, SITE } from '../site.config';
const href = (q: string) => `https://www.amazon.de/s?k=${encodeURIComponent(q)}${AFFILIATE.amazonTag ? `&tag=${AFFILIATE.amazonTag}` : ''}`;
const PL = { ps5: 'PS5', xbox: 'Xbox', beide: 'PS5 & Xbox' } as const;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Zubehör', item: `${SITE.url}/zubehoer/` },
  ],
}];
---
<Base title="GTA 6 kaufen: Spiel, Konsole, Controller und Zubehör" description="Alles, was du für GTA 6 brauchst: Spiel, PS5 oder Xbox, Controller, SSD-Speicher und Headset. Mit ehrlichen Tipps, was sich lohnt und was nicht." jsonLd={jsonLd}>
  <header class="zb-head">
    <p class="eyebrow">Einkaufsliste</p>
    <h1>Alles für GTA 6</h1>
    <p class="lead">Spiel, Konsole, Controller, Speicher und Sound. Unsere Tipps sind markiert, und wir sagen ehrlich, was du nicht brauchst.</p>
    <div class="zb-filter" role="group" aria-label="Plattform">
      <button type="button" aria-pressed="true" data-p="alle">Alle</button>
      <button type="button" aria-pressed="false" data-p="ps5">PS5</button>
      <button type="button" aria-pressed="false" data-p="xbox">Xbox</button>
    </div>
    <nav class="zb-jump" aria-label="Bereiche">{SHOP.map((s) => <a href={`#${s.id}`} style={`--c:${s.c}`}>{s.name}</a>)}</nav>
  </header>

  <AdSlot name="header" />

  {SHOP.map((s) => (
    <section class="zb-sec" id={s.id} style={`--c:${s.c}`}>
      <h2>{s.name}</h2>
      <p class="zb-intro">{s.intro}</p>
      <ul class="zb-grid">
        {s.items.map((it) => (
          <li data-pl={it.plattform ?? 'beide'}>
            <div class="zb-top">
              <span class="zb-pl">{PL[it.plattform ?? 'beide']}</span>
              {it.badge && <span class="zb-badge">{it.badge}</span>}
            </div>
            <b>{it.title}</b>
            <p>{it.note}</p>
            <a href={href(it.q)} rel="sponsored nofollow noopener" target="_blank">Bei Amazon ansehen*</a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="zb-sec zb-skip" style="--c:#ff9a4d">
    <h2>Das brauchst du nicht</h2>
    <ul>
      <li><b>PlayStation Plus oder Game Pass:</b> Für die Story von GTA 6 brauchst du kein Abo. GTA Online gibt es zum Start noch nicht.</li>
      <li><b>120-Hz-Fernseher:</b> GTA 6 läuft auf allen Konsolen mit 30 FPS. Ein normaler 4K-Fernseher reicht völlig.</li>
      <li><b>Collector's Edition:</b> Kostet 399,99 € und enthält das Spiel nicht. Mehr dazu in unserem <a href="/news/gta-6-collectors-edition-inhalt/">Artikel zur Collector's Edition</a>.</li>
      <li><b>Externe USB-Festplatte zum Spielen:</b> PS5- und Xbox-Series-Spiele lassen sich dort nur lagern, nicht spielen.</li>
    </ul>
  </section>

  <p class="zb-note"><span class="ad-label">Anzeige</span> Alle Links mit * führen zu Amazon. Als Amazon-Partner verdienen wir an qualifizierten Verkäufen. Für dich ändert sich der Preis nicht. Preise und Verfügbarkeit siehst du direkt bei Amazon.</p>
  <AdSlot name="footer" />
</Base>

<style>
  .zb-head { padding: 14px 0 10px; }
  .zb-head h1 { margin: .1em 0 .3em; color: #fff; text-shadow: 0 0 22px rgb(255 79 163 / .6); }
  .zb-filter { display: inline-flex; gap: 4px; padding: 4px; margin-top: 8px; border-radius: 999px; background: var(--night-2); border: 1px solid rgba(255,255,255,.1); }
  .zb-filter button { padding: 7px 16px; border: 0; border-radius: 999px; background: transparent; color: var(--text); font: 700 .9rem var(--font-body); }
  .zb-filter button[aria-pressed='true'] { background: var(--pink); color: #fff; box-shadow: 0 0 14px rgb(255 79 163 / .5); }
  .zb-jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .zb-jump a { padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c) 50%, transparent); color: var(--c); text-decoration: none; font-weight: 600; font-size: .9rem; }
  .zb-sec { margin: 34px 0; scroll-margin-top: 80px; }
  .zb-sec h2 { color: #fff; border-left: 4px solid var(--c); padding-left: 12px; }
  .zb-intro { color: var(--muted); max-width: 70ch; }
  .zb-grid { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .zb-grid li { display: flex; flex-direction: column; gap: 6px; padding: 16px; border-radius: 16px; background: var(--night-2); border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); }
  .zb-grid li[hidden] { display: none; }
  .zb-grid b { color: #fff; font-size: 1.05rem; }
  .zb-grid p { margin: 0; font-size: .92rem; color: var(--text); opacity: .85; flex: 1; }
  .zb-top { display: flex; gap: 6px; align-items: center; }
  .zb-pl { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--c); }
  .zb-badge { margin-left: auto; padding: 2px 8px; border-radius: 999px; background: var(--c); color: var(--night); font-size: .72rem; font-weight: 800; }
  .zb-grid a { margin-top: 6px; text-align: center; padding: 9px 12px; border-radius: 10px; background: var(--sun-1); color: var(--night); font-weight: 700; text-decoration: none; }
  .zb-grid a:hover { filter: brightness(1.08); }
  .zb-skip ul { padding-left: 1.2em; display: grid; gap: 8px; }
  .zb-note { font-size: .85rem; color: var(--muted); display: flex; gap: 10px; align-items: baseline; }
</style>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.zb-filter button')];
  btns.forEach((b) => b.addEventListener('click', () => {
    const p = b.dataset.p!;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLLIElement>('.zb-grid li').forEach((li) => {
      li.hidden = p !== 'alle' && li.dataset.pl !== p && li.dataset.pl !== 'beide';
    });
  }));
</script>
