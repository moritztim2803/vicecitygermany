---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Sunset from '../components/Sunset.astro';
import { SITE, CATEGORIES } from '../site.config';
import { allArtikel, artikelUrl } from '../lib/artikel';

const artikel = await allArtikel();
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: 'de-DE' }];
---
<Base title={`${SITE.name}: ${SITE.tagline}`} description={`${SITE.tagline}: Release, Geld verdienen, Karte, Fahrzeuge und Technik, verständlich erklärt.`} jsonLd={jsonLd}>
  <section class="hero">
    <Sunset />
    <div class="hero-text">
      <p class="eyebrow">GTA 6 auf Deutsch</p>
      <h1>Guides, Easter Eggs &amp; News aus dem Sonnenstaat</h1>
      <p>Kurze, ehrliche Antworten auf das, was du gerade in GTA 6 suchst. Ohne Spoiler, wenn nicht anders markiert.</p>
      <ul class="hero-cats">
        {CATEGORIES.map((c) => <li><a href={`/kategorie/${c.slug}/`}>{c.name}</a></li>)}
      </ul>
    </div>
  </section>
  <section class="egg-teaser">
    <p class="eyebrow">Easter Eggs</p>
    <h2>Bigfoot, Dexters Wohnung und ein Ei ganz oben auf dem Funkturm</h2>
    <p>Die verrücktesten Geheimnisse in GTA 6, Schritt für Schritt zum Nachspielen. Spoilerfrei.</p>
    <ul>
      <li><a href="/easter-eggs/gta-6-easter-eggs/#bigfoot-finden">Bigfoot finden</a></li>
      <li><a href="/easter-eggs/gta-6-easter-eggs/#dexters-wohnung-finden">Dexters Wohnung finden</a></li>
      <li><a href="/easter-eggs/gta-6-easter-eggs/#das-ei-auf-dem-höchsten-funkturm">Das Ei auf dem Funkturm</a></li>
    </ul>
    <a class="btn" href="/kategorie/easter-eggs/">Alle Easter Eggs</a>
  </section>
  <AdSlot name="header" />
  <h2 class="section-title">Neueste Artikel</h2>
  <div class="grid">
    {artikel.map((a) => (
      <ArticleCard href={artikelUrl(a)} title={a.data.title} description={a.data.description}
        category={a.data.category} date={a.data.updatedDate ?? a.data.publishDate} />
    ))}
  </div>
  <h2 class="section-title">Kategorien</h2>
  <ul class="cat-list">
    {CATEGORIES.map((c) => <li><a href={`/kategorie/${c.slug}/`}><strong>{c.name}</strong><span>{c.description}</span></a></li>)}
  </ul>
</Base>
