---
import '@fontsource/righteous/400.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { SITE, ADS, NAV } from '../site.config';
import SiteFun from '../components/SiteFun.astro';
import CookieBanner from '../components/CookieBanner.astro';
const path = Astro.url.pathname;

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, type = 'website', jsonLd = [], noindex = false, ogImage = '/og/palmenpixel.png' } = Astro.props;
const ogUrl = new URL(ogImage, Astro.site ?? SITE.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#140a24" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <!-- AdSense wird NICHT hier geladen, sondern erst nach Einwilligung (siehe CookieBanner). -->
    <meta name="x-adsense-client" content={ADS.adsenseClient} />
    {ADS.account && <meta name="google-adsense-account" content={ADS.account} />}
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/"><span class="logo-sun" aria-hidden="true"></span>{SITE.name}</a>
        <nav aria-label="Hauptnavigation">
          <ul>
            {NAV.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.name}</a></li>)}
          </ul>
        </nav>
        <a class="nav-quiz" href="/karte/gta-6-quiz-welche-region/"><span aria-hidden="true">★</span> Region-Test</a>
      </div>
    </header>
    <main id="inhalt" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">
          {SITE.name} ist eine inoffizielle Fanseite und steht in keiner Verbindung zu Rockstar Games oder Take-Two Interactive.
          „Grand Theft Auto“ und „GTA“ sind Marken von Take-Two Interactive Software, Inc.
        </p>
        <p class="disclaimer">Mit * markierte Links sind Affiliate-Links. Kaufst du darüber, erhalten wir eine kleine Provision. Für dich ändert sich der Preis nicht. Als Amazon-Partner verdienen wir an qualifizierten Verkäufen.</p>
        <ul class="footer-links">
          <li><a href="/easter-egg-melden/">Easter Egg melden</a></li>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
          <li><a href="/ueber-uns/">Über uns</a></li>
          <li><button type="button" class="linklike" data-open-consent>Cookie-Einstellungen</button></li>
        </ul>
        <p class="cheat-hint">Psst, Cheat-Code: Tipp irgendwo auf der Seite <kbd>SUNSET</kbd> ein{' '}<button type="button" class="linklike" data-sunset-toggle>oder klick hier</button>.</p>
      </div>
    </footer>
    <CookieBanner />
    <SiteFun />
  </body>
</html>
