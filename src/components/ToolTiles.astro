---
// Kacheln für die interaktiven Tools, mit Live-Stand aus dem Browser (falls vorhanden).
import { TOOLS } from '../data/tools';
interface Props { only?: string[]; compact?: boolean }
const { only, compact = false } = Astro.props;
const tools = only ? TOOLS.filter((t) => only.includes(t.id)) : TOOLS;
---
<ul class:list={['tt', { 'tt-compact': compact }]} data-tt>
  {tools.map((t, i) => (
    <li style={`--c:${t.c};--i:${i}`}>
      <a href={t.href} class="tt-a">
        <span class="tt-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d={t.icon} /></svg>
        </span>
        <span class="tt-body">
          <span class="tt-tag">{t.tag}</span>
          <b>{t.name}</b>
          {!compact && <span class="tt-claim">{t.claim}</span>}
          <span class="tt-live" data-live={t.id} hidden></span>
        </span>
        <span class="tt-go" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>

<style is:global>
  .tt { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px; }
  .tt li { animation: tt-in .5s both; animation-delay: calc(var(--i) * 70ms); }
  @keyframes tt-in { from { opacity: 0; transform: translateY(14px); } }
  .tt-a { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 14px; align-items: center; height: 100%;
    padding: 16px; border-radius: 16px; text-decoration: none; color: var(--text); overflow: hidden;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 16%, var(--night-2)), var(--night-2) 65%);
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); transition: transform .25s, box-shadow .25s, border-color .25s; }
  .tt-a::before { content: ''; position: absolute; inset: -40% auto auto -20%; width: 60%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--c) 35%, transparent), transparent 70%); opacity: .5; transition: opacity .3s, transform .5s; pointer-events: none; }
  .tt-a:hover { color: var(--text); text-shadow: none; transform: translateY(-3px); border-color: var(--c); box-shadow: 0 0 28px -6px var(--c); }
  .tt-a:hover::before { opacity: 1; transform: translate(20%, 20%); }
  .tt-ico { position: relative; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: #140a24;
    border: 1px solid var(--c); box-shadow: 0 0 16px -4px var(--c); }
  .tt-ico svg { width: 28px; height: 28px; fill: none; stroke: var(--c); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform .4s; }
  .tt-a:hover .tt-ico svg { transform: scale(1.15) rotate(-6deg); }
  .tt-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; position: relative; }
  .tt-tag { font: 700 .68rem var(--font-body); letter-spacing: .16em; text-transform: uppercase; color: var(--c); }
  .tt-body b { font: 1.2rem/1.2 var(--font-display); font-weight: 400; color: #fff; }
  .tt-claim { color: var(--muted); font-size: .9rem; line-height: 1.4; }
  .tt-live { align-self: flex-start; margin-top: 4px; padding: 2px 9px; border-radius: 99px; font: 700 .75rem var(--font-body); color: #140a24; background: var(--c); }
  .tt-go { font-size: 1.3rem; color: var(--c); transition: transform .25s; }
  .tt-a:hover .tt-go { transform: translateX(4px); }
  .tt-compact .tt-a { padding: 12px; }
  .tt-compact .tt-ico { width: 42px; height: 42px; }
  @media (prefers-reduced-motion: reduce) { .tt li { animation: none; } }
</style>

<script>
  // Live-Stand aus dem Browser in die Kacheln schreiben
  const read = (k: string) => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch { return null; } };
  const live: Record<string, string | null> = {};
  const album = read('palmenpixel-sammelkarten-v2') as Record<string, number[]> | null;
  if (album) {
    const n = Object.values(album).reduce((s, a) => s + (a?.length || 0), 0);
    if (n) live.album = `Dein Stand: ${n} / 480 Karten`;
  }
  const quiz = read('palmenpixel-quiz') as { name?: string } | null;
  if (quiz?.name) live.quiz = `Dein Ergebnis: ${quiz.name}`;
  const cl = read('palmenpixel-checklisten-v1') as Record<string, boolean> | null;
  if (cl) {
    const n = Object.values(cl).filter(Boolean).length;
    if (n) live.checklisten = `${n} Punkte abgehakt`;
  }
  const ch = read('palmenpixel-cheats-v1') as string[] | null;
  if (ch?.length) live.cheats = `${ch.length} / 61 Cheats freigeschaltet`;
  document.querySelectorAll<HTMLElement>('[data-tt] [data-live]').forEach((el) => {
    const v = live[el.dataset.live!];
    if (v) { el.textContent = v; el.hidden = false; }
  });
</script>
