---
// Trophäen-Checkliste: abhaken (nur im Browser gespeichert), nach Stufe filtern, versteckte Trophäen erst auf Wunsch aufdecken.
import { TROPHAEEN, STUFEN, type Stufe } from '../data/trophaeen';
const stufen = Object.entries(STUFEN) as [Stufe, { name: string; c: string }][];
const CUP = 'M7 4h10v4a5 5 0 0 1-10 0zM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4M12 13v4M8 21h8M9 17h6';
const versteckt = TROPHAEEN.filter((t) => t.versteckt).length;
---
<section class="tl" data-tl aria-label="Trophäen-Checkliste">
  <div class="tl-sum">
    <div class="tl-ring" style="--p:0">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={CUP} /></svg>
      <b data-tl-pct>0 %</b>
    </div>
    <div class="tl-sum-t">
      <p class="tl-big"><b data-tl-n>0</b> von {TROPHAEEN.length} Trophäen</p>
      <ul class="tl-grades">
        {stufen.map(([s, v]) => (
          <li style={`--c:${v.c}`}><i></i>{v.name} <b data-tl-g={s}>0</b>/{TROPHAEEN.filter((t) => t.stufe === s).length}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="tl-bar">
    <div class="tl-chips" role="group" aria-label="Filter">
      <button type="button" class="tl-chip" aria-pressed="true" data-f="all">Alle <span>{TROPHAEEN.length}</span></button>
      <button type="button" class="tl-chip" aria-pressed="false" data-f="offen">Noch offen</button>
      {stufen.filter(([s]) => s !== 'platin').map(([s, v]) => (
        <button type="button" class="tl-chip" aria-pressed="false" data-f={s} style={`--c:${v.c}`}>{v.name} <span>{TROPHAEEN.filter((t) => t.stufe === s).length}</span></button>
      ))}
      <button type="button" class="tl-chip" aria-pressed="false" data-f="nostory">Ohne Story</button>
    </div>
    <label class="tl-reveal"><input type="checkbox" data-tl-all /> Alle {versteckt} versteckten Trophäen aufdecken (Spoiler)</label>
  </div>

  <ul class="tl-list">
    {TROPHAEEN.map((t) => (
      <li class:list={['tl-item', { 'is-hidden': t.versteckt }]} data-id={t.id} data-s={t.stufe} data-story={t.story ? '1' : ''} style={`--c:${STUFEN[t.stufe].c}`}>
        <button type="button" class="tl-check" aria-pressed="false" aria-label={`${t.versteckt ? 'Versteckte Trophäe' : t.name} erledigt`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={CUP} /></svg>
        </button>
        <div class="tl-main">
          <p class="tl-name"><span class="tl-real">{t.name}</span>{t.versteckt && <span class="tl-fake">Versteckte Trophäe</span>} <small>{STUFEN[t.stufe].name}{t.story ? ' · Story' : ''}</small></p>
          <p class="tl-text"><span class="tl-real">{t.text}</span>{t.versteckt && <button type="button" class="tl-show tl-fake">Aufdecken</button>}</p>
        </div>
      </li>
    ))}
  </ul>
  <p class="tl-empty" hidden>Hier ist nichts mehr offen. Stark!</p>
</section>

<style>
  .tl { margin: 22px 0 30px; }
  .tl-sum { display: flex; gap: 18px; align-items: center; padding: 16px 18px; border-radius: 16px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--sun-1) 14%, var(--night-2)), var(--night-2)); border: 1px solid color-mix(in srgb, var(--sun-1) 40%, transparent); }
  .tl-ring { --p: 0; position: relative; flex: none; width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center;
    background: conic-gradient(var(--sun-1) calc(var(--p) * 1%), var(--night-3) 0); transition: --p .5s; }
  .tl-ring::before { content: ''; position: absolute; inset: 7px; border-radius: 50%; background: var(--night-2); }
  .tl-ring svg { position: relative; width: 26px; height: 26px; margin-top: -14px; fill: none; stroke: var(--sun-1); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tl-ring b { position: absolute; bottom: 20px; font: 700 .95rem var(--font-body); color: #fff; }
  .tl-big { margin: 0 0 6px; font-family: var(--font-display); font-size: 1.25rem; color: #fff; }
  .tl-big b { color: var(--sun-1); }
  .tl-grades { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: .9rem; color: var(--muted); }
  .tl-grades i { display: inline-block; width: 10px; height: 10px; margin-right: 6px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px var(--c); }
  .tl-grades b { color: #fff; }
  .tl-bar { margin: 16px 0 10px; }
  .tl-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tl-chip { --c: var(--cyan); padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); background: transparent; color: var(--text); font: 600 .88rem var(--font-body); }
  .tl-chip span { opacity: .6; font-weight: 500; }
  .tl-chip[aria-pressed='true'] { background: color-mix(in srgb, var(--c) 22%, transparent); border-color: var(--c); color: #fff; box-shadow: 0 0 14px color-mix(in srgb, var(--c) 35%, transparent); }
  .tl-reveal { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: .9rem; color: var(--muted); cursor: pointer; }
  .tl-reveal input { width: 18px; height: 18px; accent-color: var(--pink); }
  .tl-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .tl-item { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: center; padding: 12px 14px; border-radius: 14px;
    background: var(--night-2); border: 1px solid rgba(255,255,255,.07); border-left: 3px solid var(--c); }
  .tl-item[hidden] { display: none; }
  .tl-item.is-on { background: color-mix(in srgb, var(--c) 8%, var(--night-2)); }
  .tl-item.is-on .tl-real, .tl-item.is-on .tl-fake { opacity: .7; }
  .tl-check { width: 40px; height: 40px; border-radius: 12px; border: 2px solid color-mix(in srgb, var(--c) 55%, transparent); background: transparent; display: grid; place-items: center; padding: 0; }
  .tl-check svg { width: 22px; height: 22px; fill: none; stroke: color-mix(in srgb, var(--c) 55%, transparent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tl-item.is-on .tl-check { background: var(--c); border-color: var(--c); box-shadow: 0 0 14px color-mix(in srgb, var(--c) 60%, transparent); }
  .tl-item.is-on .tl-check svg { stroke: var(--night); }
  .tl-main p { margin: 0; }
  .tl-name { font-weight: 700; color: #fff; }
  .tl-name small { margin-left: 6px; font-weight: 600; font-size: .78rem; color: var(--c); }
  .tl-text { font-size: .92rem; opacity: .9; }
  .tl-item.is-hidden:not(.is-open) .tl-real { display: none; }
  .tl-item.is-open .tl-fake { display: none; }
  .tl-name .tl-fake { color: var(--muted); font-style: italic; }
  .tl-show { margin-top: 4px; padding: 4px 10px; border-radius: 8px; border: 1px dashed rgba(255,255,255,.25); background: transparent; color: var(--text); font: 600 .8rem var(--font-body); }
  .tl-show:hover { border-color: var(--pink); color: #fff; }
  .tl-empty { color: var(--muted); }
  @media (max-width: 520px) { .tl-sum { flex-direction: column; align-items: flex-start; } }
</style>

<script>
  const KEY = 'palmenpixel-trophaeen-v1';
  document.querySelectorAll<HTMLElement>('[data-tl]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLLIElement>('.tl-item')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.tl-chip')];
    const all = root.querySelector<HTMLInputElement>('[data-tl-all]')!;
    const empty = root.querySelector<HTMLElement>('.tl-empty')!;
    let f = 'all';
    let on: string[] = [];
    try { on = JSON.parse(localStorage.getItem(KEY) || '[]') || []; } catch { on = []; }
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(on)); } catch { /* privater Modus */ } };

    const paint = () => {
      const grades: Record<string, number> = {};
      items.forEach((li) => {
        const yes = on.includes(li.dataset.id!);
        li.classList.toggle('is-on', yes);
        li.querySelector('.tl-check')!.setAttribute('aria-pressed', String(yes));
        if (yes) grades[li.dataset.s!] = (grades[li.dataset.s!] || 0) + 1;
      });
      const pct = Math.round((on.length / items.length) * 100);
      root.querySelector('[data-tl-n]')!.textContent = String(on.length);
      root.querySelector('[data-tl-pct]')!.textContent = `${pct} %`;
      root.querySelector<HTMLElement>('.tl-ring')!.style.setProperty('--p', String(pct));
      root.querySelectorAll<HTMLElement>('[data-tl-g]').forEach((b) => { b.textContent = String(grades[b.dataset.tlG!] || 0); });
    };
    const filter = () => {
      let n = 0;
      items.forEach((li) => {
        const show = f === 'all' || (f === 'offen' && !on.includes(li.dataset.id!)) || (f === 'nostory' && !li.dataset.story) || li.dataset.s === f;
        li.hidden = !show; if (show) n++;
      });
      empty.hidden = n > 0;
    };

    chips.forEach((b) => b.addEventListener('click', () => {
      f = b.dataset.f!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
      filter();
    }));
    all.addEventListener('change', () => items.forEach((li) => li.classList.toggle('is-open', all.checked)));
    items.forEach((li) => {
      li.querySelector('.tl-check')!.addEventListener('click', () => {
        const id = li.dataset.id!;
        on = on.includes(id) ? on.filter((x) => x !== id) : [...on, id];
        save(); paint(); if (f === 'offen') filter();
      });
      li.querySelector('.tl-show')?.addEventListener('click', () => li.classList.add('is-open'));
    });
    paint(); filter();
  });
</script>
