---
// Cheat-Liste: suchen, nach Art filtern, Code kopieren, freigeschaltete Cheats abhaken (nur im Browser gespeichert).
import { CHEATS, KATS, ARROW, codeText, type CheatKat } from '../data/cheats';
const kats = Object.entries(KATS) as [CheatKat, { name: string; c: string }][];
const mitCode = CHEATS.filter((c) => c.code).length;
---
<section class="cl" data-cl aria-label="Cheat-Liste">
  <div class="cl-how">
    <p class="cl-how-t">So gibst du einen Cheat ein</p>
    <ol>
      <li><b>Handy öffnen:</b> Steuerkreuz <kbd>↑</kbd></li>
      <li><b>Halten:</b> <kbd>L1</kbd> + <kbd>R1</kbd> (Xbox: <kbd>LB</kbd> + <kbd>RB</kbd>)</li>
      <li><b>Code drücken:</b> die Pfeile mit dem Steuerkreuz, Tasten dabei weiter halten</li>
    </ol>
    <p class="cl-warn">Achtung: Nach einem Cheat sind <b>Trophäen und Speichern</b> bis zum Neustart des Spiels gesperrt. Vorher speichern!</p>
  </div>

  <div class="cl-bar">
    <input type="search" class="cl-search" placeholder="Cheat suchen, z. B. Geld, Panzer, Wetter" aria-label="Cheat suchen" data-cl-q />
    <div class="cl-chips" role="group" aria-label="Art">
      <button type="button" class="cl-chip" aria-pressed="true" data-k="all">Alle <span>{CHEATS.length}</span></button>
      {kats.map(([k, v]) => (
        <button type="button" class="cl-chip" aria-pressed="false" data-k={k} style={`--c:${v.c}`}>{v.name} <span>{CHEATS.filter((c) => c.kat === k).length}</span></button>
      ))}
      <button type="button" class="cl-chip cl-chip-code" aria-pressed="false" data-code>Nur mit Code <span>{mitCode}</span></button>
    </div>
    <p class="cl-count" aria-live="polite"><b data-cl-n>0</b> von {CHEATS.length} freigeschaltet <span class="cl-bar-p"><i data-cl-p></i></span></p>
  </div>

  <ul class="cl-list">
    {CHEATS.map((c) => (
      <li class="cl-item" data-id={c.id} data-k={c.kat} data-has={c.code ? '1' : ''} data-s={`${c.name} ${c.sub} ${c.unlock} ${KATS[c.kat].name} ${c.tags ?? ""}`.toLowerCase()} style={`--c:${KATS[c.kat].c}`}>
        <button type="button" class="cl-check" aria-pressed="false" aria-label={`${c.name} freigeschaltet`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </button>
        <div class="cl-main">
          <p class="cl-name">{c.name} <small>{c.sub}</small></p>
          <p class="cl-unlock"><span>Freischalten:</span> {c.unlock}</p>
        </div>
        <div class="cl-code">
          {c.code ? (
            <>
              <span class="cl-keys" aria-label={`Code: ${codeText(c.code)}`}>{[...c.code].map((k) => <kbd>{ARROW[k]}</kbd>)}</span>
              <button type="button" class="cl-copy" data-copy={codeText(c.code)}>Kopieren</button>
            </>
          ) : <span class="cl-none">Code folgt</span>}
        </div>
      </li>
    ))}
  </ul>
  <p class="cl-empty" hidden>Kein Cheat gefunden.</p>
</section>

<style>
  .cl { margin: 22px 0 30px; }
  .cl-how { padding: 16px 18px; border-radius: 16px; background: linear-gradient(135deg, color-mix(in srgb, var(--pink) 14%, var(--night-2)), var(--night-2)); border: 1px solid color-mix(in srgb, var(--pink) 40%, transparent); }
  .cl-how-t { margin: 0 0 8px; font-family: var(--font-display); font-size: 1.15rem; color: #fff; }
  .cl-how ol { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .cl-warn { margin: 12px 0 0; font-size: .92rem; color: var(--sun-1); }
  .cl kbd { display: inline-grid; place-items: center; min-width: 1.9em; height: 1.9em; padding: 0 .35em; border-radius: 7px; font: 700 .9rem var(--font-body);
    background: var(--night-3); color: #fff; border: 1px solid rgba(255,255,255,.18); box-shadow: 0 2px 0 rgba(0,0,0,.45); }
  .cl-bar { position: sticky; top: 64px; z-index: 2; margin: 18px 0 10px; padding: 12px 0 8px; background: var(--night); }
  .cl-search { width: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,.16); background: var(--night-2); color: var(--text); font: inherit; }
  .cl-search:focus { outline: 2px solid var(--cyan); outline-offset: 1px; }
  .cl-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .cl-chip { --c: var(--cyan); padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); background: transparent; color: var(--text); font: 600 .88rem var(--font-body); }
  .cl-chip span { opacity: .6; font-weight: 500; }
  .cl-chip[aria-pressed='true'] { background: color-mix(in srgb, var(--c) 22%, transparent); border-color: var(--c); color: #fff; box-shadow: 0 0 14px color-mix(in srgb, var(--c) 35%, transparent); }
  .cl-chip-code { --c: var(--sun-1); }
  .cl-count { display: flex; align-items: center; gap: 10px; margin: 10px 0 0; font-size: .9rem; color: var(--muted); }
  .cl-count b { color: #fff; }
  .cl-bar-p { flex: 1; max-width: 220px; height: 6px; border-radius: 6px; background: var(--night-3); overflow: hidden; }
  .cl-bar-p i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--pink), var(--sun-1)); transition: width .4s; }
  .cl-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .cl-item { display: grid; grid-template-columns: auto 1fr auto; gap: 12px 14px; align-items: center; padding: 12px 14px; border-radius: 14px;
    background: var(--night-2); border: 1px solid rgba(255,255,255,.07); border-left: 3px solid var(--c); }
  .cl-item[hidden] { display: none; }
  .cl-item.is-on { background: color-mix(in srgb, var(--c) 9%, var(--night-2)); }
  .cl-check { width: 30px; height: 30px; border-radius: 9px; border: 2px solid color-mix(in srgb, var(--c) 60%, transparent); background: transparent; display: grid; place-items: center; padding: 0; }
  .cl-check svg { width: 18px; height: 18px; fill: none; stroke: var(--night); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
  .cl-item.is-on .cl-check { background: var(--c); border-color: var(--c); box-shadow: 0 0 12px color-mix(in srgb, var(--c) 55%, transparent); }
  .cl-item.is-on .cl-check svg { opacity: 1; }
  .cl-main p { margin: 0; }
  .cl-name { font-weight: 700; color: #fff; }
  .cl-name small { margin-left: 6px; font-weight: 500; font-size: .8rem; color: var(--muted); }
  .cl-unlock { font-size: .9rem; color: var(--text); opacity: .85; }
  .cl-unlock span { color: var(--c); font-weight: 600; }
  .cl-code { display: flex; align-items: center; gap: 8px; justify-content: flex-end; }
  .cl-keys { display: flex; flex-wrap: wrap; gap: 3px; max-width: 300px; justify-content: flex-end; }
  .cl-keys kbd { min-width: 1.6em; height: 1.6em; font-size: .8rem; border-radius: 6px; }
  .cl-copy { padding: 6px 10px; border-radius: 9px; border: 1px solid color-mix(in srgb, var(--c) 50%, transparent); background: transparent; color: var(--c); font: 700 .8rem var(--font-body); }
  .cl-copy:hover, .cl-copy.is-done { background: var(--c); color: var(--night); }
  .cl-none { font-size: .78rem; color: var(--muted); padding: 4px 9px; border-radius: 999px; border: 1px dashed rgba(255,255,255,.18); white-space: nowrap; }
  .cl-empty { color: var(--muted); }
  @media (max-width: 760px) {
    .cl-bar { position: static; }
    .cl-item { grid-template-columns: auto 1fr; }
    .cl-code { grid-column: 1 / -1; justify-content: flex-start; }
    .cl-keys { justify-content: flex-start; max-width: none; }
    .cl-item:not([data-has='1']) .cl-code { display: none; }
  }
</style>

<script>
  const KEY = 'palmenpixel-cheats-v1';
  document.querySelectorAll<HTMLElement>('[data-cl]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLLIElement>('.cl-item')];
    const q = root.querySelector<HTMLInputElement>('[data-cl-q]')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.cl-chip[data-k]')];
    const codeBtn = root.querySelector<HTMLButtonElement>('[data-code]')!;
    const empty = root.querySelector<HTMLElement>('.cl-empty')!;
    let kat = 'all', nurCode = false;
    let on: string[] = [];
    try { on = JSON.parse(localStorage.getItem(KEY) || '[]') || []; } catch { on = []; }
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(on)); } catch { /* privater Modus */ } };

    const paint = () => {
      items.forEach((li) => {
        const yes = on.includes(li.dataset.id!);
        li.classList.toggle('is-on', yes);
        li.querySelector('.cl-check')!.setAttribute('aria-pressed', String(yes));
      });
      root.querySelector('[data-cl-n]')!.textContent = String(on.length);
      root.querySelector<HTMLElement>('[data-cl-p]')!.style.width = `${(on.length / items.length) * 100}%`;
    };
    const filter = () => {
      const s = q.value.trim().toLowerCase();
      let n = 0;
      items.forEach((li) => {
        const show = (kat === 'all' || li.dataset.k === kat) && (!nurCode || li.dataset.has === '1') && (!s || li.dataset.s!.includes(s));
        li.hidden = !show; if (show) n++;
      });
      empty.hidden = n > 0;
    };

    q.addEventListener('input', filter);
    chips.forEach((b) => b.addEventListener('click', () => {
      kat = b.dataset.k!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
      filter();
    }));
    codeBtn.addEventListener('click', () => { nurCode = !nurCode; codeBtn.setAttribute('aria-pressed', String(nurCode)); filter(); });
    items.forEach((li) => {
      li.querySelector('.cl-check')!.addEventListener('click', () => {
        const id = li.dataset.id!;
        on = on.includes(id) ? on.filter((x) => x !== id) : [...on, id];
        save(); paint();
      });
      li.querySelector<HTMLButtonElement>('.cl-copy')?.addEventListener('click', async (e) => {
        const b = e.currentTarget as HTMLButtonElement;
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Kopiert!'; } catch { b.textContent = b.dataset.copy!; }
        b.classList.add('is-done');
        setTimeout(() => { b.textContent = 'Kopieren'; b.classList.remove('is-done'); }, 1600);
      });
    });
    paint(); filter();
  });
</script>
