---
import { ADS } from '../site.config';
interface Props { name: 'header' | 'in-article' | 'sidebar' | 'footer' }
const { name } = Astro.props;
const slot = ADS.slots[name];
const live = Boolean(ADS.adsenseClient);
---
<aside class={`ad ad-${name}`} aria-label="Anzeige">
  <span class="ad-label">Anzeige</span>
  {live ? (
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADS.adsenseClient}
      data-ad-slot={slot || undefined} data-ad-format="auto" data-full-width-responsive="true"></ins>
  ) : (
    <div class="ad-placeholder">Werbeplatz „{name}“</div>
  )}
</aside>
